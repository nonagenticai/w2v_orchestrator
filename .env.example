# W2V Orchestrator Service Configuration
ENVIRONMENT=development
APP_NAME=W2V Orchestrator Service

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5450/w2v_orchestrator  # pragma: allowlist secret

# Redis
REDIS_URL=redis://localhost:6390/0

# API
API_HOST=0.0.0.0
API_PORT=6300
API_DEBUG=false

# Auth
AUTH_ENABLED=false
DEFAULT_TENANT_ID=0195f48b-d000-7000-8000-000000000001

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data

# Pipeline
PIPELINE_MODE=gateway
PIPELINE_MAX_CONCURRENT_PIPELINES=10
PIPELINE_DEFAULT_TIMEOUT_SECONDS=7200

# Downstream service license token -- REQUIRED, no code default (boot fails if unset)
DOWNSTREAM_LICENSE_TOKEN=

# Local-dev: route all peer services to localhost:<port>
# W2V_LOCAL=1
#
# Per-peer overrides (e.g. for port-forwards or mocks):
# W2V_ANALYSIS_URL=http://localhost:6303
# W2V_CONTENT_URL=http://localhost:6305
# W2V_TTS_URL=http://localhost:6194

# Logging
LOG_LEVEL=INFO
LOG_JSON_LOGS=false

# Tracing
TRACING_ENABLED=false
